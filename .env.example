# Podman 对宿主机暴露的回环端口，外网只通过宿主机 Nginx 访问。
HTTP_PORT=8088

# 可选：配置后自动优先使用 DeepL；Free 密钥以 :fx 结尾，会自动选择 Free API。
DEEPL_API_KEY=
# 一般留空。只有使用自建代理或测试服务时才设置。
DEEPL_ENDPOINT=

# 可选：MyMemory 建议为高频调用提供联系邮箱，不填也可使用匿名额度。
MYMEMORY_EMAIL=

# 访问统计 Dashboard (/admin/analytics) 的管理员令牌。
# 必须设置才能访问管理接口；留空表示整体停用。请使用长随机字符串，例如：
#   openssl rand -hex 24
ANALYTICS_ADMIN_TOKEN=

# 可选：原始事件保留天数（默认 14，最小 3，最大 90）。
# 按日聚合数据不受此限制，会长期保留。
ANALYTICS_RAW_RETENTION_DAYS=14

# ===== PDF 转 Markdown（云端 OCR + AI 翻译）=====
# PaddleOCR（AI Studio 星河社区）文档解析 API Token。
# 获取：aistudio.baidu.com → 访问令牌（AccessToken）页面。
# 留空则“PDF 转 Markdown”工具的解析接口整体停用。Token 只保存在服务器，绝不写入前端。
PADDLEOCR_API_TOKEN=
# 可选：默认 https://paddleocr.aistudio-app.com
PADDLEOCR_API_BASE=
# 可选：默认 PP-StructureV3
PADDLEOCR_MODEL=

# AI 翻译服务（OpenAI-compatible 接口）。三项全部配置后才会启用“翻译为中文”。
TRANSLATION_API_BASE=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# 可选限制（默认值）：单文件大小 MB / 页数 / OCR 每日全局额度 /
# 翻译每日全局额度 / 任务数据保留小时数。
PDF_MAX_SIZE_MB=18
PDF_MAX_PAGES=100
PDF_OCR_DAILY_QUOTA=100
PDF_TRANSLATE_DAILY_QUOTA=100
PDF_JOB_TTL_HOURS=24
